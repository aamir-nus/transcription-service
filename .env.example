# Copy to .env and fill in HF_TOKEN. Everything else has working defaults;
# lines are grouped as in the config block at the top of transcribe.py.

# Required: read token from https://huggingface.co/settings/tokens after
# accepting the conditions of the gated diarization model
# https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Whisper model (the mlx-community conversion is derived from this name).
TRANSCRIPTION_MODEL=large-v3-turbo

# Device strategy (see transcribe.py config block):
#   DEVICE drives the pure-PyTorch stages -- alignment + diarization.
#   'auto' -> MPS on Apple Silicon. Set DEVICE=cpu to force the slow path.
DEVICE=auto

# ASR backend: 'auto' -> MLX whisper on the Apple GPU (fp16, VAD-chunked, ~3x
# faster than CPU int8 here); 'ct2' -> faster-whisper/CTranslate2 on CPU
# (ASR_DEVICE / ASR_THREADS / COMPUTE_TYPE below apply to ct2 only).
ASR_BACKEND=auto
MLX_MODEL=

# ct2 (faster-whisper) fallback knobs. faster-whisper has NO MPS backend, so it
# is always CPU; ASR_THREADS defaults to all cores.
ASR_DEVICE=cpu
ASR_THREADS=8
COMPUTE_TYPE=int8
BATCH_SIZE=8

# Run diarization in parallel with ASR+alignment (diarize only needs the audio).
# 'auto' = on with the mlx backend; 'true'/'false' force.
PARALLEL_STAGES=auto

# Diarization segmentation hop (seconds). 2.0 halves the embedding-crop count
# vs upstream's 1.0 (~2x faster diarize, ~1.6% frame-level speaker diffs);
# set 1.0 to restore upstream behavior exactly.
DIARIZE_SEG_STEP=2.0

# Diarization strategy ladder: 'fast' (default) embeds VAD windows and verifies
# against the speaker roster, 'auto' additionally escalates on weak quality
# signals, 'pyannote' always runs the full pipeline. Fast escalates to full
# pyannote automatically whenever its preconditions fail (unknown voice, too
# many voices, no roster, ...).
DIARIZE_MODE=fast
DIARIZE_FAST_MAX_VOICES=4
DIARIZE_FAST_CLUSTER_THRESHOLD=0.50
DIARIZE_FAST_MERGE_THRESHOLD=0.65
DIARIZE_FAST_REFINE=0.10
DIARIZE_FAST_MAX_FLIP=0.20

# Speaker memory: link voices to stable SPEAKER_XX tags across files using the
# diarizer's own per-speaker embeddings (no extra compute). New voices get the
# next unused tag; delete .speakers.json to reset the namespace.
SPEAKER_LINKING=true
# SPEAKER_LINK_THRESHOLD=0.70     # match cutoff (calibrated; see OPTIMIZATION_LOG)
# SPEAKER_STORE=.speakers.json    # relocate the store

# HTTP API + IO locations (defaults shown; uncomment to change).
# HOST=0.0.0.0
# PORT=8000
# DATA_DIR=Data
# OUTPUT_DIR=Output
# DEFAULT_OUTPUT_FORMAT=md        # md | vtt
# RESUME=true                     # checkpoint each stage; re-runs resume
# CHECKPOINT_DIR=.transcribe_cache
# DIARIZE_MODEL=                  # override diarization model
